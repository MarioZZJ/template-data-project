# Secrets and local environments
.env
.env.*
!.env.example
.venv/
env/
venv/

# Python and uv caches
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
*.egg-info/
dist/
build/

# Local editor and operating-system files
.vscode/*
.idea/
.DS_Store
Thumbs.db
*~

# Data layers: ignore payloads while allowing directory facts and metadata
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/**/
!data/interim/**/
!data/processed/**/
!data/external/**/
!data/**/.gitkeep
!data/**/README.md
!data/**/metadata.*
!data/**/checksums.*
!data/**/*-metadata.*
!data/**/*-checksums.*

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp

