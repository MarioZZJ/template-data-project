# 环境变量配置文件
# 复制此文件为.env并填入实际值，不要将包含敏感信息的.env文件提交到版本控制

# =============================================================================
# 项目基础配置
# =============================================================================

# 项目名称
PROJECT_NAME=python-data-analysis-template

# 项目版本
PROJECT_VERSION=0.1.0

# 调试模式 (True/False)
DEBUG=True

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# 路径配置
# =============================================================================

# 数据根目录
DATA_PATH=./data

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库连接字符串（SQLite 示例）
# DATABASE_URL=sqlite:///data/database.db

# SQL Server（MSSQL）连接配置
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=your_database
# MSSQL_UID=your_username
# MSSQL_PWD=your_password

# =============================================================================
# API配置
# =============================================================================

# API密钥
# API_KEY=your_api_key_here

# =============================================================================
# 使用说明
# =============================================================================
#
# 1. 复制此文件为.env：
#    cp .env.example .env
#
# 2. 在.env文件中填入实际值，不要提交包含敏感信息的.env文件
#
# 3. 在Python代码中加载环境变量：
#    from dotenv import load_dotenv
#    import os
#    
#    load_dotenv()
#    api_key = os.getenv('API_KEY')
#    data_path = os.getenv('DATA_PATH', './src/data')
#
# 4. 确保在.gitignore中包含.env文件
#
# =============================================================================
