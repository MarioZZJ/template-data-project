# 复制为 .env 后填写实际值；.env 不提交。

PROJECT_NAME=
DATA_ROOT=./data
OUTPUT_ROOT=./outputs

# BigQuery：使用外部 gcloud/bq 登录状态；查询先 dry run。
BQ_PROJECT_ID=
BQ_LOCATION=
BQ_MAXIMUM_BYTES_BILLED=

# MSSQL / SQL Server
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no
MSSQL_CONNECTION_TIMEOUT=30

# Kaggle：也可使用 kaggle auth login 或用户目录中的 token 文件。
KAGGLE_API_TOKEN=
